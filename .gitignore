__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.worktrees/
dist/
build/
*.zip
.DS_Store

# Rigour scan artifacts (generated by `npx @rigour-labs/cli scan`)
.rigour/
rigour-report.json
rigour-fix-packet.json

# Serena project store (created by activate_project; the index cache once
# reached 25 MB and polluted a reviewer's file counts)
.serena/

# Hermes scratch / atomic-write temp artifacts (e.g. .hermes-tmp.Qw7TB7). One was
# committed by accident on 2026-10-17; these are never source and must not be
# tracked.
.hermes-tmp.*


# Lane briefs are working notes, not repo content
.briefs/
*.log

# Local scratch
cache/
# Lane and audit working notes, and editor/merge leftovers. `scratch/` is a real
# hazard: git does not report an empty directory, so it hides until it is not empty.
scratch/
*.orig
*.rej
*.bak
*.swp
*~

# The v1 single-palette skin pack (150 files) is RETIRED: the build reads
# only skins-v2/, and the pack is kept recoverable from the published commit
# 9439f41 (tests/test_regenerate.py proves it). This entry stops the
# retired pack from being re-introduced by accident.
skins/
